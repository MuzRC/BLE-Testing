<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BLE Testing &amp; Cloner Pro"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginBottom="8dp" />

    <!-- Bar Butang Alat: Profil, Inject Manual & Eksport CSV -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnBookmarks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="★ Profil"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnManualInject"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text="✎ Inject"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnExportCsv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⤓ CSV"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Kawalan Slider Jarak RSSI Masa Nyata -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="4dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvRssiLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tapis: -75 dBm"
            android:textSize="13sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/sbRssi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="60"
            android:progress="25" />
    </LinearLayout>

    <!-- Kotak Status Maklumat & Data Semasa -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E2E8F0"
        android:textColor="#0F172A"
        android:padding="12dp"
        android:text="Tekan '1. Mula Imbas Signal' untuk mengesan peranti."
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Senarai Signal BLE Terdekat (Ketik untuk pilih):"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <!-- Senarai Pilihan Peranti -->
    <ListView
        android:id="@+id/lvDevices"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#334155"
        android:dividerHeight="1dp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnScan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Mula Imbas Signal" />

    <Button
        android:id="@+id/btnBroadcast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="2. Pancar Klon (Advertise)" />

    <Button
        android:id="@+id/btnStopBroadcast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Henti Pancaran" />

</LinearLayout>
