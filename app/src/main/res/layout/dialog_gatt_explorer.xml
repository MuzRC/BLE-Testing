<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#12121A"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvGattTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GATT Explorer &amp; Live Terminal"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        android:layout_marginBottom="2dp" />

    <TextView
        android:id="@+id/tvGattTargetInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Peranti: Menunggu pilihan..."
        android:textColor="#888899"
        android:textSize="12sp"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1C1F2E"
        android:padding="8dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvGattStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Menyambung..."
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBatteryBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#2E334D"
            android:textColor="#00E676"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="Bateri: --%" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#0A0B10"
        android:padding="6dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvGattServicesTree"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#CAD3DE"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:text="Sedang membaca struktur GATT dalaman..." />
    </ScrollView>

    <!-- Kotak Log Semburan Live Notify -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚡ Siaran Masuk Masa Nyata (Live Stream Log):"
        android:textColor="#00E676"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <ScrollView
        android:id="@+id/svLiveStream"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#050608"
        android:padding="6dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/tvLiveStreamLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#81C784"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:text="[Menunggu langganan aktif...]" />
    </ScrollView>

    <!-- Borang Tindakan Kawalan & Langganan -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1B1E2E"
        android:padding="8dp"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <EditText
                android:id="@+id/etWriteCharUuid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="UUID Karakteristik (cth: 2A19)"
                android:textColorHint="#666677"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:background="#0F1018"
                android:padding="8dp" />

            <Button
                android:id="@+id/btnToggleNotify"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📡 Langgan"
                android:backgroundTint="#00E5FF"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="11sp"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etWriteHexValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Payload Hex (cth: 01FF)"
                android:textColorHint="#666677"
                android:textColor="#00E5FF"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:background="#0F1018"
                android:padding="8dp"
                android:inputType="textCapCharacters" />

            <Button
                android:id="@+id/btnSendHex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tulis"
                android:backgroundTint="#B388FF"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="11sp"
                android:layout_marginStart="6dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/btnGattDisconnect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Putuskan"
            android:backgroundTint="#FF5252"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnGattClose"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tutup"
            android:backgroundTint="#2E3248"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

</LinearLayout>
