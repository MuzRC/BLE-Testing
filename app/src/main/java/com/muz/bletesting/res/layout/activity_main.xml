<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BLE Testing &amp; Cloner Pro"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp" />

    <!-- Bar Alat Pintas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnBookmarks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="★ Profil"
            android:textSize="12sp"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnManualInject"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="✎ Inject"
            android:textSize="12sp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnExportCsv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⤓ CSV"
            android:textSize="12sp"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Kawalan Slider Jarak RSSI -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1E1E1E"
        android:padding="8dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvRssiLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tapis: -75 dBm"
            android:textColor="#00E676"
            android:textSize="12sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/sbRssi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="60"
            android:progress="25" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E1E2E"
        android:textColor="#E0E0E0"
        android:textSize="12sp"
        android:padding="12dp"
        android:fontFamily="monospace"
        android:text="Sedia untuk memulakan operasi."
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Senarai Signal Berdekatan (Ketik untuk simpan):"
        android:textColor="#AAAAAA"
        android:textSize="13sp"
        android:layout_marginBottom="4dp" />

    <ListView
        android:id="@+id/lvDevices"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#2A2A2A"
        android:dividerHeight="1dp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnScan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Mula Imbas Signal"
        android:backgroundTint="#B388FF"
        android:textColor="#000000"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <Button
        android:id="@+id/btnBroadcast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2. Pancar Klon (Advertise)"
        android:backgroundTint="#B388FF"
        android:textColor="#000000"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <Button
        android:id="@+id/btnStopBroadcast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Henti Pancaran"
        android:backgroundTint="#B388FF"
        android:textColor="#000000"
        android:textStyle="bold" />
</LinearLayout>
